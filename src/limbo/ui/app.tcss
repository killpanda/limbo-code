/* Limbo TUI — Limbo Dusk：聊天流 + 右侧栏，窄屏收成单栏，集中管理所有样式。
 *
 * 用色规范见 RFC LIM-16 v1.1 §6.3：本文件只允许引用主题语义变量
 * （limbo-dark / limbo-light 由 src/limbo/ui/theme.py 注册），禁止裸 hex。
 * 例外：Game2048 tile 色为游戏语义色，豁免。
 */

/* ---- 顶部状态栏：状态 + ╱ 斜线纹理；窄屏时再加字标和上下文摘要 ---- */
#statusbar {
    height: 1;
    padding: 0 1;
    background: $background;
}
#statusbar-logo {
    width: auto;
    display: none;
}
#statusbar-state {
    width: auto;
    padding-right: 1;
    color: $text-secondary;
}
#statusbar-diag {
    width: 1fr;
    color: $diag;
    overflow: hidden;
}
#statusbar-state.thinking {
    color: $primary;
}
#statusbar-state.tool {
    color: $primary;
}
#statusbar-context {
    width: auto;
    padding-left: 1;
    color: $text-secondary;
    text-align: right;
    display: none;
}
MainScreen #statusbar {
    display: none;
}
MainScreen.-compact #statusbar {
    display: block;
}
MainScreen.-compact #statusbar-logo,
MainScreen.-compact #statusbar-context {
    display: block;
}

/* ---- 主体：聊天列 + 右侧栏 ---- */
#body {
    height: 1fr;
    layers: base overlay;
}
#main-col {
    width: 1fr;
    height: 1fr;
}
#sidebar {
    width: 36;
    height: 1fr;
    padding: 1 2;
    background: $surface;
    border-left: vkey $border-subtle;
    scrollbar-size-vertical: 1;
}
#sidebar Static {
    height: auto;
}
#sidebar .sb-group {
    margin-top: 1;
}
MainScreen.-compact #sidebar {
    display: none;
}
/* ctrl+d：窄屏下把侧栏临时盖在聊天右侧 */
MainScreen.-compact.-peek #sidebar {
    display: block;
    dock: right;
    layer: overlay;
    border-left: tall $primary;
}

/* ---- 聊天流 ---- */
ChatWidget {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}
.user-message {
    width: 1fr;
    background: $user-message-bg;
    color: $user-message-fg;
    border-left: thick $primary;
    padding: 0 1;
    margin-top: 1;
}
.assistant-message {
    margin-top: 1;
    padding: 0;
}
.thinking-message {
    /* Vertical defaults to height: 1fr — without this a thinking block eats
       all free space when the conversation is shorter than the viewport
       (fresh session, just after resume), leaving a huge blank gap. */
    height: auto;
    color: $text-tertiary;
    text-style: italic;
    margin-top: 1;
}
.thinking-summary {
    color: $thinking;
    text-style: italic;
}
.thinking-summary:hover {
    text-style: bold italic;
}
.thinking-body {
    color: $text-tertiary;
    text-style: italic;
    padding-left: 2;
    border-left: solid $diag;
}
.error-message {
    width: 1fr;
    background: $error-bg;
    color: $error-bright;
    padding: 0 1;
    margin-top: 1;
}
.info-message {
    color: $text-secondary;
}
.attachment-chips {
    color: $text-secondary;
    padding: 0 1;
    margin-left: 2;
}
.queued-message {
    width: 1fr;
    height: auto;
}
.queued-message .user-message {
    margin-top: 1;
}
.queued-status {
    height: 1;
    margin-left: 2;
}
.queued-hint {
    color: $text-tertiary;
}
.queued-cancel {
    color: $text-secondary;
    margin-left: 2;
    text-style: underline;
}
.queued-cancel:hover {
    color: $error-bright;
}
.queued-message.cancelled .user-message {
    color: $text-tertiary;
    text-style: strike;
}
.voided {
    color: $text-tertiary;
    text-style: strike;
}
.queued-message.cancelled .queued-hint {
    color: $text-tertiary;
}
.ascii-art {
    color: $text-secondary;
    margin-top: 1;
}
#load-more {
    height: 1;
    background: $panel;
    color: $accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}
#load-more:hover {
    color: $primary;
}
#back-to-bottom {
    dock: bottom;
    height: 1;
    background: $accent;
    color: $background;
    text-style: bold;
    text-align: center;
}

/* ---- Markdown 元素（RFC §6.3：heading=accent，code fence=bg-elevated+primary 左边框） ---- */
MarkdownH1, MarkdownH2, MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6 {
    color: $accent;
}
MarkdownH1 {
    border-bottom: solid $border-subtle;
}
MarkdownFence {
    background: $panel;
    border-left: thick $primary;
    padding: 0 1;
}
MarkdownBlockQuote {
    color: $text-tertiary;
    border-left: outer $text-tertiary;
}
MarkdownHorizontalRule {
    color: $text-tertiary;
}
MarkdownBlock > .code_inline {
    background: $panel;
    color: $accent;
}

/* ---- 工具调用：一行语法（✓ Read  path  0.1s），展开体挂在 │ 竖线下 ---- */
ToolCard {
    height: auto;
    padding: 0 1;
}
ToolCard .tool-header {
    height: 1;
}
ToolCard:hover .tool-header {
    text-style: underline;
}
ToolCard .tool-body {
    height: auto;
    max-height: 24;
    margin-left: 2;
    padding-left: 1;
    border-left: solid $diag;
    background: $background;
}
ToolCard.error .tool-body {
    background: $error-bg;
}

/* ---- 启动页：渐变字标 + 环境 + 下一步 ---- */
Landing {
    height: auto;
    padding: 1 1 0 1;
}
Landing .landing-diag {
    height: 1;
    overflow: hidden;
}
Landing .landing-head {
    height: auto;
    margin: 1 0;
}
Landing .landing-logo {
    width: auto;
    height: auto;
    margin-right: 4;
}
Landing .landing-info {
    width: 1fr;
    height: auto;
}
Landing .landing-cols {
    height: auto;
    margin-top: 1;
}
Landing .landing-recent, Landing .landing-tips {
    width: 1fr;
    height: auto;
}
MainScreen.-compact Landing .landing-info {
    display: none;
}

/* ---- 活动行（Tide）：忙碌时出现在输入框上方 ---- */
#activity {
    height: 1;
    padding: 0 2;
    margin-top: 1;
}

/* ---- 输入框上方的状态胶囊 ---- */
#pills {
    height: 1;
    padding: 0 2;
}

/* ---- 斜杠命令自动补全菜单 ---- */
#slash-menu {
    height: auto;
    max-height: 8;
    margin: 0 1;
    border: round $primary;
    background: $surface;
}
#slash-menu .option-list--option-highlighted {
    background: $panel;
    color: $accent;
}

/* ---- 输入框（全局唯一的圆角边框，视觉锚点） ---- */
#input {
    height: 3;
    border: round $accent;
    margin: 0 1;
}
#input:focus {
    border: round $accent-lighten-1;
}

/* ---- 底部快捷键提示 ---- */
#hint {
    height: 1;
    padding: 0 2;
    background: $surface;
    color: $text-secondary;
}

/* ---- Dialog 基座：遮罩 + 卡片 + 标题 ╱ 线 ---- */
Dialog {
    align: center middle;
    background: $background 60%;
}
Dialog .dialog {
    width: 80%;
    max-width: 96;
    height: auto;
    max-height: 80%;
    background: $surface;
    border: tall $panel;
    padding: 1 2;
}
Dialog .dialog-title {
    height: 1;
    margin-bottom: 1;
    text-wrap: nowrap;
    text-overflow: clip;
}
Dialog .dialog-hint {
    height: 1;
    margin-top: 1;
}
Dialog ListView, Dialog OptionList {
    height: auto;
    max-height: 20;
    background: $surface;
    border: none;
    padding: 0;
}
Dialog ListView > ListItem.-highlight,
Dialog ListView:focus > ListItem.-highlight {
    background: $selected-bg;
    color: $selected-fg;
}
Dialog OptionList > .option-list--option-highlighted {
    background: $selected-bg;
    color: $selected-fg;
}
CommandPalette .palette-tabs {
    height: 1;
    margin-bottom: 1;
}
CommandPalette .palette-input {
    border: none;
    background: $panel;
    padding: 0 1;
    height: 1;
    margin-bottom: 1;
}

/* ---- 模型选择 / 登录弹窗 ---- */
ModelPicker #model-search, AuthDialog Input {
    border: none;
    background: $panel;
    padding: 0 1;
    height: 1;
    margin-bottom: 1;
}
AuthDialog Input:focus {
    background: $selected-bg;
}
ModelPicker ListView {
    max-height: 16;
}
ModelPicker .provider-header, ModelPicker .recent-header {
    color: $text-secondary;
    text-style: bold;
}
ModelPicker .unavailable {
    color: $text-tertiary;
}
ModelPicker .custom-row {
    color: $primary;
}
ModelPicker #picker-hint {
    color: $warning;
    height: auto;
}
AuthDialog .auth-intro {
    height: auto;
    margin-bottom: 1;
}
AuthDialog .auth-status {
    height: auto;
}

/* ---- /agents 子代理面板 ---- */
AgentsPanel .dialog {
    max-width: 120;
    height: 80%;
}
AgentsPanel #agents-list {
    height: auto;
    max-height: 12;
}
AgentsPanel #agents-detail {
    height: 1fr;
    margin-top: 1;
    border-top: solid $panel;
}
AgentsPanel #agents-detail-text {
    color: $text-secondary;
}

/* ---- /goal 验收命令确认弹窗 (LIM-40) ---- */
VerifyPicker #verify-picker {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
VerifyPicker #picker-title {
    text-style: bold;
    margin-bottom: 1;
}
VerifyPicker ListView {
    height: auto;
    max-height: 12;
}
VerifyPicker ListView:focus > ListItem.-highlight {
    background: $panel;
    color: $accent;
}

/* ---- /btw 侧问浮层 ---- */
BtwScreen {
    align: center middle;
}
BtwScreen #btw-container {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
BtwScreen #btw-question {
    text-style: bold;
    margin-bottom: 1;
}
BtwScreen #btw-answer-scroll {
    height: auto;
    max-height: 24;
}
BtwScreen #btw-footer {
    margin-top: 1;
    color: $text-secondary;
}

/* ---- 2048 游戏弹窗 ---- */
Game2048Screen {
    align: center middle;
}
Game2048Screen #game-container {
    width: auto;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
Game2048Screen #game-header {
    text-style: bold;
    margin-bottom: 1;
    content-align: center middle;
    width: 100%;
}
Game2048Screen #game-grid {
    grid-size: 4 4;
    grid-columns: 6;
    grid-rows: 3;
    grid-gutter: 1;
    width: 27;
    height: 15;
}
Game2048Screen #game-footer {
    margin-top: 1;
    color: $text-secondary;
    content-align: center middle;
    width: 100%;
}
/* tile 色为 2048 游戏语义色（数值越大越暖），豁免统一色板 */
Game2048Screen .tile {
    content-align: center middle;
    text-style: bold;
    width: 100%;
    height: 3;
    background: $surface-lighten-1;
    color: $text-secondary;
}
Game2048Screen .tile-2     { background: #eee4da; color: #776e65; }
Game2048Screen .tile-4     { background: #ede0c8; color: #776e65; }
Game2048Screen .tile-8     { background: #f2b179; color: #f9f6f2; }
Game2048Screen .tile-16    { background: #f59563; color: #f9f6f2; }
Game2048Screen .tile-32    { background: #f67c5f; color: #f9f6f2; }
Game2048Screen .tile-64    { background: #f65e3b; color: #f9f6f2; }
Game2048Screen .tile-128   { background: #edcf72; color: #f9f6f2; }
Game2048Screen .tile-256   { background: #edcc61; color: #f9f6f2; }
Game2048Screen .tile-512   { background: #edc850; color: #f9f6f2; }
Game2048Screen .tile-1024  { background: #edc53f; color: #f9f6f2; }
Game2048Screen .tile-2048  { background: #edc22e; color: #f9f6f2; }
Game2048Screen .tile-super { background: #3c3a32; color: #f9f6f2; }
