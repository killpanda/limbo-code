/* Limbo TUI — pi 风格单栏布局，集中管理所有样式。
 *
 * 用色规范见 RFC LIM-16 v1.1 §6.3：本文件只允许引用主题语义变量
 * （limbo-dark / limbo-light 由 src/limbo/ui/theme.py 注册），禁止裸 hex。
 * 例外：Game2048 tile 色为游戏语义色，豁免。
 */

/* ---- 顶部状态栏 ---- */
#statusbar {
    height: 1;
    padding: 0 1;
    background: $surface;
}
#statusbar-state {
    width: 1fr;
    color: $text-secondary;
}
#statusbar-state.thinking {
    color: $primary;
}
#statusbar-state.tool {
    color: $primary;
}
#statusbar-context {
    width: auto;
    color: $text-secondary;
    text-align: right;
}

/* ---- 聊天流 ---- */
ChatWidget {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}
.user-message {
    width: 1fr;
    background: $surface;
    border-left: thick $primary;
    padding: 0 1;
    margin-top: 1;
}
.assistant-message {
    margin-top: 1;
    padding: 0;
}
.thinking-message {
    color: $text-tertiary;
    text-style: italic;
    margin-top: 1;
}
.thinking-summary {
    color: $text-tertiary;
    text-style: italic;
}
.thinking-summary:hover {
    text-style: bold italic;
}
.thinking-body {
    color: $text-tertiary;
    text-style: italic;
}
.error-message {
    width: 1fr;
    background: $error-bg;
    color: $error-bright;
    padding: 0 1;
    margin-top: 1;
}
.info-message {
    color: $text-secondary;
}
.attachment-chips {
    color: $text-secondary;
    padding: 0 1;
    margin-left: 2;
}
.queued-message {
    width: 1fr;
    height: auto;
}
.queued-message .user-message {
    margin-top: 1;
}
.queued-status {
    height: 1;
    margin-left: 2;
}
.queued-hint {
    color: $text-tertiary;
}
.queued-cancel {
    color: $text-secondary;
    margin-left: 2;
    text-style: underline;
}
.queued-cancel:hover {
    color: $error-bright;
}
.queued-message.cancelled .user-message {
    color: $text-tertiary;
    text-style: strike;
}
.queued-message.cancelled .queued-hint {
    color: $text-tertiary;
}
.ascii-art {
    color: $text-secondary;
    margin-top: 1;
}
#load-more {
    height: 1;
    background: $panel;
    color: $accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}
#load-more:hover {
    color: $primary;
}
#back-to-bottom {
    dock: bottom;
    height: 1;
    background: $accent;
    color: $background;
    text-style: bold;
    text-align: center;
}

/* ---- Markdown 元素（RFC §6.3：heading=accent，code fence=bg-elevated+primary 左边框） ---- */
MarkdownH1, MarkdownH2, MarkdownH3, MarkdownH4, MarkdownH5, MarkdownH6 {
    color: $accent;
}
MarkdownH1 {
    border-bottom: solid $border-subtle;
}
MarkdownFence {
    background: $panel;
    border-left: thick $primary;
    padding: 0 1;
}
MarkdownBlockQuote {
    color: $text-tertiary;
    border-left: outer $text-tertiary;
}
MarkdownHorizontalRule {
    color: $text-tertiary;
}
MarkdownBlock > .code_inline {
    background: $panel;
    color: $accent;
}

/* ---- 工具调用卡片 ---- */
ToolCard {
    height: auto;
    padding-left: 1;
    background: $surface;
    border-left: thick $primary;
}
ToolCard.success {
    border-left: thick $success;
}
ToolCard.error {
    border-left: thick $error;
    background: $error-bg;
}
ToolCard .tool-header {
    height: 1;
    color: $text-secondary;
}
ToolCard.running .tool-header {
    color: $primary;
}
ToolCard.success .tool-header {
    color: $success;
}
ToolCard.error .tool-header {
    color: $error-bright;
}
ToolCard .tool-body {
    height: auto;
    max-height: 24;
    padding-left: 1;
    border-left: solid $border-default;
    background: $surface;
}
ToolCard.error .tool-body {
    background: $error-bg;
}

/* ---- 斜杠命令自动补全菜单 ---- */
#slash-menu {
    height: auto;
    max-height: 8;
    margin: 0 1;
    border: round $primary;
    background: $surface;
}
#slash-menu .option-list--option-highlighted {
    background: $panel;
    color: $accent;
}

/* ---- 输入框（全局唯一的圆角边框，视觉锚点） ---- */
#input {
    height: 3;
    border: round $accent;
    margin: 0 1;
}
#input:focus {
    border: round $accent-lighten-1;
}

/* ---- 底部快捷键提示 ---- */
#hint {
    height: 1;
    padding: 0 2;
    color: $text-secondary;
}

/* ---- 会话选择弹窗 ---- */
SessionPicker {
    align: center middle;
}
SessionPicker #session-picker {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
SessionPicker #picker-title {
    text-style: bold;
    margin-bottom: 1;
}
SessionPicker ListView {
    height: auto;
    max-height: 20;
}
SessionPicker ListView:focus > ListItem.-highlight {
    background: $panel;
    color: $accent;
}

/* ---- 模型选择弹窗 ---- */
ModelPicker {
    align: center middle;
}
ModelPicker #model-picker {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
ModelPicker #picker-title {
    text-style: bold;
    margin-bottom: 1;
}
ModelPicker ListView {
    height: auto;
    max-height: 24;
}
ModelPicker ListView:focus > ListItem.-highlight {
    background: $panel;
    color: $accent;
}
ModelPicker .provider-header {
    color: $text-secondary;
    text-style: bold;
}
ModelPicker .unavailable {
    color: $text-tertiary;
}
ModelPicker #picker-hint {
    color: $warning;
    margin-top: 1;
    height: auto;
}

/* ---- /goal 验收命令确认弹窗 (LIM-40) ---- */
VerifyPicker #verify-picker {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
VerifyPicker #picker-title {
    text-style: bold;
    margin-bottom: 1;
}
VerifyPicker ListView {
    height: auto;
    max-height: 12;
}
VerifyPicker ListView:focus > ListItem.-highlight {
    background: $panel;
    color: $accent;
}

/* ---- /btw 侧问浮层 ---- */
BtwScreen {
    align: center middle;
}
BtwScreen #btw-container {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
BtwScreen #btw-question {
    text-style: bold;
    margin-bottom: 1;
}
BtwScreen #btw-answer-scroll {
    height: auto;
    max-height: 24;
}
BtwScreen #btw-footer {
    margin-top: 1;
    color: $text-secondary;
}

/* ---- 2048 游戏弹窗 ---- */
Game2048Screen {
    align: center middle;
}
Game2048Screen #game-container {
    width: auto;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
Game2048Screen #game-header {
    text-style: bold;
    margin-bottom: 1;
    content-align: center middle;
    width: 100%;
}
Game2048Screen #game-grid {
    grid-size: 4 4;
    grid-columns: 6;
    grid-rows: 3;
    grid-gutter: 1;
    width: 27;
    height: 15;
}
Game2048Screen #game-footer {
    margin-top: 1;
    color: $text-secondary;
    content-align: center middle;
    width: 100%;
}
/* tile 色为 2048 游戏语义色（数值越大越暖），豁免统一色板 */
Game2048Screen .tile {
    content-align: center middle;
    text-style: bold;
    width: 100%;
    height: 3;
    background: $surface-lighten-1;
    color: $text-secondary;
}
Game2048Screen .tile-2     { background: #eee4da; color: #776e65; }
Game2048Screen .tile-4     { background: #ede0c8; color: #776e65; }
Game2048Screen .tile-8     { background: #f2b179; color: #f9f6f2; }
Game2048Screen .tile-16    { background: #f59563; color: #f9f6f2; }
Game2048Screen .tile-32    { background: #f67c5f; color: #f9f6f2; }
Game2048Screen .tile-64    { background: #f65e3b; color: #f9f6f2; }
Game2048Screen .tile-128   { background: #edcf72; color: #f9f6f2; }
Game2048Screen .tile-256   { background: #edcc61; color: #f9f6f2; }
Game2048Screen .tile-512   { background: #edc850; color: #f9f6f2; }
Game2048Screen .tile-1024  { background: #edc53f; color: #f9f6f2; }
Game2048Screen .tile-2048  { background: #edc22e; color: #f9f6f2; }
Game2048Screen .tile-super { background: #3c3a32; color: #f9f6f2; }
