/* Limbo TUI — pi 风格单栏布局，集中管理所有样式 */

/* ---- 顶部状态栏 ---- */
#statusbar {
    height: 1;
    padding: 0 1;
    background: $surface;
}
#statusbar-state {
    width: 1fr;
    color: $text-muted;
}
#statusbar-state.thinking {
    color: $warning;
}
#statusbar-state.tool {
    color: $accent;
}
#statusbar-context {
    width: auto;
    color: $text-muted;
    text-align: right;
}

/* ---- 聊天流 ---- */
ChatWidget {
    width: 1fr;
    height: 1fr;
    padding: 0 1;
}
.user-message {
    color: $text-accent;
    margin-top: 1;
}
.assistant-message {
    margin-top: 1;
    padding: 0;
}
.error-message {
    color: $error;
    margin-top: 1;
}
.info-message {
    color: $text-muted;
}

/* ---- 工具调用卡片 ---- */
ToolCard {
    height: auto;
    padding-left: 1;
}
ToolCard .tool-header {
    height: 1;
    color: $text-muted;
}
ToolCard.running .tool-header {
    color: $warning;
}
ToolCard.success .tool-header,
ToolCard.applied .tool-header {
    color: $success;
}
ToolCard.error .tool-header,
ToolCard.rejected .tool-header {
    color: $error;
}
ToolCard.pending .tool-header {
    color: $warning;
}
ToolCard .tool-body {
    height: auto;
    max-height: 24;
    padding-left: 1;
    border-left: solid $primary-lighten-2;
}

/* ---- 斜杠命令自动补全菜单 ---- */
#slash-menu {
    height: auto;
    max-height: 8;
    margin: 0 1;
    border: round $primary;
    background: $surface;
}

/* ---- 输入框（全局唯一的圆角边框，视觉锚点） ---- */
#input {
    height: 3;
    border: round $accent;
    margin: 0 1;
}
#input:focus {
    border: round $accent-lighten-1;
}

/* ---- 底部快捷键提示 ---- */
#hint {
    height: 1;
    padding: 0 2;
    color: $text-muted;
}

/* ---- 确认弹窗 ---- */
ConfirmDialog {
    align: center middle;
}
ConfirmDialog > Vertical {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $warning;
    background: $surface;
    padding: 1 2;
}
ConfirmDialog #dialog-title {
    text-style: bold;
    margin-bottom: 1;
}
ConfirmDialog #dialog-warning {
    color: $warning;
    margin-top: 1;
}
ConfirmDialog #diff-body {
    max-height: 60%;
}
ConfirmDialog #dialog-buttons {
    height: auto;
    align: center middle;
    margin-top: 1;
}
ConfirmDialog Button {
    margin: 0 1;
}

/* ---- 会话选择弹窗 ---- */
SessionPicker {
    align: center middle;
}
SessionPicker #session-picker {
    width: 80%;
    max-width: 110;
    height: auto;
    max-height: 80%;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
SessionPicker #picker-title {
    text-style: bold;
    margin-bottom: 1;
}
SessionPicker ListView {
    height: auto;
    max-height: 20;
}

/* ---- 2048 游戏弹窗 ---- */
Game2048Screen {
    align: center middle;
}
Game2048Screen #game-container {
    width: auto;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}
Game2048Screen #game-header {
    text-style: bold;
    margin-bottom: 1;
    content-align: center middle;
    width: 100%;
}
Game2048Screen #game-grid {
    grid-size: 4 4;
    grid-columns: 6;
    grid-rows: 3;
    grid-gutter: 1;
    width: 27;
    height: 15;
}
Game2048Screen #game-footer {
    margin-top: 1;
    color: $text-muted;
    content-align: center middle;
    width: 100%;
}
Game2048Screen .tile {
    content-align: center middle;
    text-style: bold;
    width: 100%;
    height: 3;
    background: $surface-lighten-1;
    color: $text-muted;
}
Game2048Screen .tile-2     { background: #eee4da; color: #776e65; }
Game2048Screen .tile-4     { background: #ede0c8; color: #776e65; }
Game2048Screen .tile-8     { background: #f2b179; color: #f9f6f2; }
Game2048Screen .tile-16    { background: #f59563; color: #f9f6f2; }
Game2048Screen .tile-32    { background: #f67c5f; color: #f9f6f2; }
Game2048Screen .tile-64    { background: #f65e3b; color: #f9f6f2; }
Game2048Screen .tile-128   { background: #edcf72; color: #f9f6f2; }
Game2048Screen .tile-256   { background: #edcc61; color: #f9f6f2; }
Game2048Screen .tile-512   { background: #edc850; color: #f9f6f2; }
Game2048Screen .tile-1024  { background: #edc53f; color: #f9f6f2; }
Game2048Screen .tile-2048  { background: #edc22e; color: #f9f6f2; }
Game2048Screen .tile-super { background: #3c3a32; color: #f9f6f2; }
